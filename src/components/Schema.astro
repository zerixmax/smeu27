---
import { kw } from '../i18n/ui';

interface Props {
  lang?: 'hr' | 'en' | 'de';
}

const { lang: _lang = 'hr' } = Astro.props;

// SEO ključni pojmovi (HR + EN + DE) — katalog za LocalBusiness knowsAbout
const kwKatalog = [
  ...kw.hr.emergency,
  ...kw.hr.underwater,
  ...kw.hr.electronics,
  ...kw.en.emergency,
  ...kw.en.underwater,
  ...kw.en.electronics,
  ...kw.de.emergency,
  ...kw.de.underwater,
  ...kw.de.electronics
];

// Prošireni stručni pojmovi: ovlašteni servis motora, pramčani motori /
// ribolovna elektronika, podvodni pregledi za HRB i komercijalna pomoć na moru.
const extendedKnowsAbout = [
  // Ovlašteni servis vanbrodskih motora i garancije
  "Ovlašteni servis vanbrodskih motora Honda",
  "Ovlašteni servis Suzuki Marine",
  "Ovlašteni servis Tohatsu",
  "Ovlašteni servis Hidea",
  "Servis Yamaha i Mercury motora",
  "Računalna dijagnostika brodskih motora",
  "Računalna dijagnostika i očitavanje grešaka brodskih motora",
  "Podešavanje parametara rada vanbrodskih motora",
  "Sanacija oštećenja trupa kod prodora vode",
  "Interventno krpanje trupa drvenih brodova",
  // Pramčani motori i ribolovna elektronika
  "Ugradnja Minn Kota pramčanih motora",
  "Garmin Force ugradnja i kalibracija",
  "Lowrance Ghost trolling motor",
  "MotorGuide montaža",
  "Thru-hull montaža sondi kroz trup",
  "Kalibracija sonara i CHIRP sondi",
  "Bow-mount trolling motor installation (Minn Kota, Garmin Force)",
  "Bugmotoren-Montage und Echolot-Kalibrierung (Minn Kota, Garmin Force)",
  // HRB podvodni pregledi i podvodni radovi
  "Podvodni pregledi za Hrvatski registar brodova (HRB)",
  "In-water survey Croatian Register of Shipping",
  "Unterwasser-Inspektionen für das kroatische Schiffsregister (HRB)",
  "Zamjena cink protektora u moru",
  "Izrada i polaganje kolpa morta",
  "Deblokada propelera od konopa i muringa",
  "Komercijalna pomoć na moru i tegljenje plovila"
];

const latitude = 42.9586505;

// Recenzije koje su vidljive u sekciji #lokacija-recenzije (recenzije.autentične)
const reviews = [
  {
    "@type": "Review",
    "author": { "@type": "Person", "name": "Marko R." },
    "reviewRating": { "@type": "Rating", "ratingValue": "5", "bestRating": "5" },
    "datePublished": "2026-08",
    "reviewBody": "Pukao nam je konop na ulazu u luku i zamotao se oko propele. Čovjek je došao u roku od 20 minuta, zaronio i riješio stvar bez vađenja broda."
  },
  {
    "@type": "Review",
    "author": { "@type": "Person", "name": "Stefan M." },
    "reviewRating": { "@type": "Rating", "ratingValue": "5", "bestRating": "5" },
    "datePublished": "2026-07",
    "reviewBody": "Top Service in Vela Luka! Kranung mit dem Scania LKW verlief absolut professionell und vorsichtig mit Hebetraversen."
  },
  {
    "@type": "Review",
    "author": { "@type": "Person", "name": "Ante J." },
    "reviewRating": { "@type": "Rating", "ratingValue": "5", "bestRating": "5" },
    "datePublished": "2026-05",
    "reviewBody": "Godinama ostavljam brod na suhom vezu kod Nikole. Miran san preko zime, konzervacija motora i priprema za sezonu uvijek odrađeni po dogovoru."
  }
];

const schema = {
