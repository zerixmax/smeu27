};

const current = data[lang] || data.hr;
---

<!-- Sekcija: Usluge -->
<section id="usluge" class="py-20 bg-slate-900/50 border-b border-slate-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 class="text-3xl sm:text-4xl font-black text-white">{current.heading}</h2>
      <p class="mt-3 text-slate-400">{current.subheading}</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {current.services.map((item) => (
        <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6 hover:border-slate-700 transition-colors">
          <div class="w-12 h-12 rounded-xl bg-red-600/10 text-red-500 flex items-center justify-center mb-5 font-black text-xl">
            {item.num}
          </div>
          <h3 class="text-xl font-bold text-white mb-2">{item.title}</h3>
          <p class="text-sm text-slate-400 leading-relaxed">{item.desc}</p>
          {item.link && (
            <div class="mt-4 pt-4 border-t border-slate-800 flex items-center justify-between gap-3">
              <span class="text-[11px] text-emerald-400 font-mono">{item.exp}</span>
              <a
                href={item.link.href}
                class="text-xs text-slate-300 hover:text-white flex items-center gap-1 group font-semibold"
              >
                {item.link.label}
                <svg class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </a>
            </div>
          )}
        </div>
      ))}

      <!-- Istaknuti blok: Hitne intervencije u luci i akvatoriju -->
      <div
        id="hitne-intervencije"
        class="lg:col-span-3 bg-gradient-to-br from-red-950/40 via-slate-900 to-slate-900 border-2 border-red-600/40 rounded-2xl p-6 sm:p-8 shadow-glow-red"
      >
        <div class="flex items-center gap-3 flex-wrap">
          <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-red-600/15 border border-red-500/40 text-red-400 text-xs font-black uppercase tracking-widest">
            <span class="relative flex w-2 h-2">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-red-500 opacity-75"></span>
              <span class="relative inline-flex rounded-full w-2 h-2 bg-red-500"></span>
            </span>
            {current.emergency.badge}
          </span>
          <span class="text-xs text-slate-400">24/7</span>
        </div>

        <h3 class="mt-4 text-2xl sm:text-3xl font-black text-white">
          <span class="text-red-500">{current.emergency.subtitle}</span>
          <span class="text-slate-500 font-bold text-sm block sm:inline sm:ml-3">— {current.emergency.title}</span>
        </h3>

        <ul class="mt-5 space-y-3">
          {current.emergency.items.map((item) => (
            <li class="flex items-start gap-3 text-sm text-slate-200 leading-relaxed">
              <svg class="w-5 h-5 text-red-500 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
              <span>{item}</span>
            </li>
          ))}
        </ul>

        <a
          href="tel:+385989540388"
          class="mt-6 inline-flex items-center gap-2 px-5 py-3 bg-red-600 hover:bg-red-700 text-white font-bold rounded-xl shadow-glow-red transition-all text-sm"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
          </svg>
          +385 98 954 03 88
        </a>
      </div>
    </div>
  </div>
</section>
