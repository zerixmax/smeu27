---
interface Props {
  lang?: 'hr' | 'en' | 'de';
}

interface ServiceItem {
  num: string;
  title: string;
  desc: string;
  exp?: string;
  link?: { href: string; label: string };
}

interface LangData {
  heading: string;
  subheading: string;
  services: ServiceItem[];
  emergency: { badge: string; title: string; subtitle: string; items: string[] };
}

const { lang = 'hr' } = Astro.props;

const data: Record<'hr' | 'en' | 'de', LangData> = {
  hr: {
    heading: "Sveobuhvatna marinska podrška",
