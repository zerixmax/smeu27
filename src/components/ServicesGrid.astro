---
interface Props {
  lang?: 'hr' | 'en' | 'de';
}

const { lang = 'hr' } = Astro.props;

const data = {
  hr: {
    heading: "Sveobuhvatna marinska podrška",
    subheading: "Kompletne tehničke i servisne usluge na jednom mjestu za bezbrižnu plovidbu.",
    services: [
      {
        num: "01",
        title: "Suhi vez i čuvanje plovila",
        desc: "Smještaj na osiguranom postolju na parceli 500 m od mora, uz mogućnost otvorenog i natkrivenog čuvanja pod ceradom."
      },
      {
        num: "02",
        title: "Vađenje i transport (16 t kran)",
        desc: "Manipulacija kamionskim kranom Scania F600 uz 3 namjenske širilice za brage koje čuvaju strukturu trupa i ograde."
      },
      {
        num: "03",
        title: "Servis i konzervacija motora",
        desc: "Redovno održavanje i priprema za zimu za Yamaha, Suzuki i Mercury vanbrodske motore; zamjena impelera, ulja i filtera te profesionalna ugradnja novih motora."
      },
      {
        num: "04",
        title: "Popravci stakloplastike i trupa",
        desc: "Sanacija oštećenja gelcoata, plastificiranje, farbanje, antivegetativna zaštita (koper) te servis gumenjaka."
      },
      {
        num: "05",
        title: "Ugradnja opreme i elektronike",
        desc: "Montaža krmenih platformi, skala, sidrenih vitla, navigacijskih sondera i plotera (Garmin, Lowrance, Minn Kota), bušenje i ugradnja sondi kroz trup te izrada inox tankova po mjeri."
      },
      {
        num: "06",
        title: "Pranje pod visokim tlakom",
        desc: "Temeljito skidanje algi i školjaka neposredno nakon vađenja broda uz ekološka biorazgradiva sredstva za čišćenje."
      }
    ],
    emergency: {
      badge: "Hitne intervencije",
      title: "Hitne intervencije u luci i akvatoriju",
      subtitle: "Ronioc / Hitni zahvati",
      items: [
        "Oslobađanje osovine i propele od konopa i mreža u moru (bez vađenja ako je moguće).",
        "Privremeno krpanje prodora vode i hitno vađenje na kran od 16 t ako trup popusti.",
        "Ugradnja i kontrola korpo morta i bova za siguran vez."
      ]
    }
  },
  en: {
    heading: "Comprehensive Marine Services",
    subheading: "Complete boat storage, lifting, and technical support in one place for safe cruising.",
    services: [
      {
        num: "01",
        title: "Dry Dock & Boat Storage",
        desc: "Secure cradle accommodation on dedicated land 500 m from the sea, offering open-air and covered boat storage."
      },
      {
        num: "02",
        title: "Haul-out & Transport (16 t Crane)",
        desc: "Handling with Scania F600 truck crane using 3 specialized spreader bars that protect hull integrity and railings."
      },
      {
        num: "03",
        title: "Engine Service & Winterizing",
        desc: "Routine maintenance and winterizing for Yamaha, Suzuki and Mercury outboard engines; impeller, oil, and filter replacements, and expert engine installations."
      },
      {
        num: "04",
        title: "Fiberglass & Gelcoat Repairs",
        desc: "Gelcoat cosmetic repairs, lamination, polishing, antifouling application, and RIB inflatable tube patching."
      },
      {
        num: "05",
        title: "Marine Electronics & Equipment",
        desc: "Installation of swim platforms, ladders, windlasses, GPS fishfinders (Garmin, Lowrance, Minn Kota), thru-hull transducer mounting, and custom stainless steel marine tanks."
      },
      {
        num: "06",
        title: "High-Pressure Hull Washing",
        desc: "Immediate high-pressure wash removing algae and barnacles straight after haul-out using eco-friendly detergents."
      }
    ],
    emergency: {
      badge: "Emergency Response",
      title: "Emergency Marine Services in Port & Waters",
      subtitle: "Diver / emergency operations",
      items: [
        "Propeller and shaft freed from ropes and nets in the water (no haul-out required when possible).",
        "Temporary hull-leak patching and emergency 16 t crane haul-out if the hull is compromised.",
        "Corpo morto and mooring buoy installation & inspection for safe mooring."
      ]
    }
  },
  de: {
    heading: "Umfassende Marinedienste",
    subheading: "Komplette Liegeplatz-, Hebe- und Servicedienstleistungen aus einer Hand.",
    services: [
      {
        num: "01",
        title: "Trockenliegeplatz & Lagerung",
        desc: "Gesicherte Bootslagerung auf Böcken 500 m vom Meer, wahlweise im Freien oder überdacht mit Schutzplane."
      },
      {
        num: "02",
        title: "Ein- & Auskranen (16 t Kran)",
        desc: "Bootsmanipulation mit Scania F600 LKW-Kran und 3 Spezial-Hebetraversen zur Schonung von Rumpf und Reling."
      },
      {
        num: "03",
        title: "Motorenservice & Einwinterung",
        desc: "Regelmäßige Wartung und Einwinterung für Yamaha-, Suzuki- und Mercury-Außenbordmotoren; Wechsel von Impeller, Öl und Filtern sowie Neumotormontage."
      },
      {
        num: "04",
        title: "GFK- & Rumpfreparaturen",
        desc: "Instandsetzung von Gelcoat-Schäden, Laminieren, Polieren, Antifouling-Beschichtung sowie Reparatur von Festrumpfschlauchbooten."
      },
      {
        num: "05",
        title: "Bootsausrüstung & Elektronik",
        desc: "Montage von Badeplattformen, Leitern, Ankerwinden, GPS-Kartenplottern (Garmin, Lowrance, Minn Kota), Through-Hull-Gebermontage und Anfertigung von Edelstahltanks nach Maß."
      },
      {
        num: "06",
        title: "Hochdruck-Rumpfreinigung",
        desc: "Gründliche Beseitigung von Algen und Seepocken unmittelbar nach dem Auskranen mit umweltfreundlichen Reinigern."
      }
    ],
    emergency: {
      badge: "Notfall-Einsatz",
      title: "Notfälle im Hafen und Revier",
      subtitle: "Taucher / Notfall-Einsätze",
      items: [
        "Propeller und Welle von Leinen und Netzen unter Wasser befreien (wenn möglich ohne Auskranen).",
        "Vorübergehende Abdichtung von Wassereinbrüchen und Notauskranen mit dem 16-t-Kran bei Rumpfschäden.",
        "Einbau und Kontrolle von Corpo Morto und Mooringbojen für sichere Liegeplätze."
      ]
    }
  }
};

const current = data[lang] || data.hr;
---

<!-- Sekcija: Usluge -->
<section id="usluge" class="py-20 bg-slate-900/50 border-b border-slate-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 class="text-3xl sm:text-4xl font-black text-white">{current.heading}</h2>
      <p class="mt-3 text-slate-400">{current.subheading}</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {current.services.map((item) => (
        <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6 hover:border-slate-700 transition-colors">
          <div class="w-12 h-12 rounded-xl bg-red-600/10 text-red-500 flex items-center justify-center mb-5 font-black text-xl">
            {item.num}
          </div>
          <h3 class="text-xl font-bold text-white mb-2">{item.title}</h3>
          <p class="text-sm text-slate-400 leading-relaxed">{item.desc}</p>
        </div>
      ))}

      <!-- Istaknuti blok: Hitne intervencije u luci i akvatoriju -->
      <div
        id="hitne-intervencije"
        class="lg:col-span-3 bg-gradient-to-br from-red-950/40 via-slate-900 to-slate-900 border-2 border-red-600/40 rounded-2xl p-6 sm:p-8 shadow-glow-red"
      >
        <div class="flex items-center gap-3 flex-wrap">
          <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-red-600/15 border border-red-500/40 text-red-400 text-xs font-black uppercase tracking-widest">
            <span class="relative flex w-2 h-2">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-red-500 opacity-75"></span>
              <span class="relative inline-flex rounded-full w-2 h-2 bg-red-500"></span>
            </span>
            {current.emergency.badge}
          </span>
          <span class="text-xs text-slate-400">24/7</span>
        </div>

        <h3 class="mt-4 text-2xl sm:text-3xl font-black text-white">
          <span class="text-red-500">{current.emergency.subtitle}</span>
          <span class="text-slate-500 font-bold text-sm block sm:inline sm:ml-3">— {current.emergency.title}</span>
        </h3>

        <ul class="mt-5 space-y-3">
          {current.emergency.items.map((item) => (
            <li class="flex items-start gap-3 text-sm text-slate-200 leading-relaxed">
              <svg class="w-5 h-5 text-red-500 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
              <span>{item}</span>
            </li>
          ))}
        </ul>

        <a
          href="tel:+385989540388"
          class="mt-6 inline-flex items-center gap-2 px-5 py-3 bg-red-600 hover:bg-red-700 text-white font-bold rounded-xl shadow-glow-red transition-all text-sm"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
          </svg>
          +385 98 954 03 88
        </a>
      </div>
    </div>
  </div>
</section>
