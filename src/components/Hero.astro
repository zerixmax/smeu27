---
import { Image } from 'astro:assets';
import { useTranslations } from '../i18n/ui';

import imgKran from '../assets/images/gallery/7-suha-marina-vela-luka-2022.jpeg';

interface Props {
  lang?: 'hr' | 'en' | 'de';
}

const { lang = 'hr' } = Astro.props;
const t = useTranslations(lang);

const phoneDisplay = "+385 98 954 03 88";
const phoneRaw = "385989540388";
const whatsappMsg = encodeURIComponent(t('cta.whatsapp_msg'));

const spreadersText = lang === 'en' ? '3 spreaders' : lang === 'de' ? '3 Traversen' : '3 širilice';
---

<!-- Hero sekcija s kranom -->
<section id="kran" class="relative pt-12 pb-16 lg:py-24 bg-white border-b border-slate-200 scroll-mt-24">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      
      <div class="lg:col-span-7">
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight leading-tight text-slate-900">
          {t('hero.title_pre')} <span class="text-sky-800">{t('hero.title_highlight')}</span>
        </h1>

        <p class="mt-5 text-base sm:text-lg text-slate-700 leading-relaxed max-w-2xl">
          {t('hero.desc')}
        </p>

        <!-- CTA Gumbi -->
        <div class="mt-8 flex flex-wrap gap-4 items-center">
          <a
            href={`https://wa.me/${phoneRaw}?text=${whatsappMsg}`}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2.5 px-6 py-3.5 bg-[#25D366] hover:bg-[#20ba5a] text-white font-bold rounded-xl shadow-md transition-transform hover:-translate-y-0.5 text-sm"
          >
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
              <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/>
            </svg>
            <span>{t('cta.whatsapp')}</span>
          </a>

          <a
            href={`tel:+${phoneRaw}`}
            class="inline-flex items-center gap-2.5 px-6 py-3.5 bg-sky-800 hover:bg-sky-900 text-white font-bold rounded-xl border border-sky-900 shadow-md transition-transform hover:-translate-y-0.5 text-sm"
          >
            <svg class="w-5 h-5 text-sky-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
            </svg>
            <span>{phoneDisplay}</span>
          </a>
        </div>
      </div>

      <!-- Kran u akciji: kamionski kran Scania F600 AXP (16 t, 3 širilice) -->
      <div class="lg:col-span-5">
        <div class="relative w-full rounded-2xl overflow-hidden shadow-lg border border-slate-200 bg-slate-100">
          <Image
            src={imgKran}
            alt="Kamionski kran Scania F600 AXP od 16 tona s 3 širilice diže jedrilicu u Veloj Luci"
            widths={[360, 450]}
            sizes="(max-width: 1023px) calc(100vw - 2rem), 490px"
            class="w-full h-full object-cover"
            format="webp"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
          <div class="bg-slate-900 text-slate-100 px-4 py-2.5 flex items-center justify-between text-xs font-medium border-t border-slate-200">
            <span>16 t Scania F600 AXP • {spreadersText}</span>
            <span class="bg-sky-800 text-white px-2 py-0.5 rounded font-mono">{spreadersText}</span>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
