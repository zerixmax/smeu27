---
import { Image } from 'astro:assets';
import { useTranslations } from '../i18n/ui';

import imgKran from '../assets/images/gallery/7-suha-marina-vela-luka-2022.jpeg';

interface Props {
  lang?: 'hr' | 'en' | 'de';
}

const { lang = 'hr' } = Astro.props;
const t = useTranslations(lang);

const phoneDisplay = "+385 98 954 03 88";
const phoneRaw = "385989540388";
const whatsappMsg = encodeURIComponent(t('cta.whatsapp_msg'));

const spreadersText = lang === 'en' ? '3 spreaders' : lang === 'de' ? '3 Traversen' : '3 širilice';
---

<!-- Hero sekcija s kranom i specifikacijama -->
<section id="kran" class="relative pt-12 pb-16 lg:py-24 border-b border-slate-800/80 bg-radial from-slate-900 via-slate-950 to-slate-950 scroll-mt-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      
      <div class="lg:col-span-7">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-red-600/10 text-red-500 border border-red-600/20 text-xs font-semibold uppercase tracking-wider mb-6">
          <span class="w-2 h-2 rounded-full bg-red-500 animate-pulse"></span>
          {t('hero.badge')}
        </div>

        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight leading-tight text-white">
          {t('hero.title_pre')} <span class="text-transparent bg-clip-text bg-gradient-to-r from-red-500 to-amber-500">{t('hero.title_highlight')}</span>
        </h1>

        <p class="mt-5 text-base sm:text-lg text-slate-300 leading-relaxed max-w-2xl">
          {t('hero.desc')}
        </p>

        <!-- Specifikacije -->
        <div class="mt-8 grid grid-cols-3 gap-4 border-y border-slate-800 py-4 max-w-xl">
          <div>
            <div class="text-2xl sm:text-3xl font-black text-red-500">16 t</div>
            <div class="text-xs text-slate-400 uppercase tracking-wider mt-1">{t('spec.crane')}</div>
          </div>
          <div>
            <div class="text-2xl sm:text-3xl font-black text-white">{spreadersText}</div>
            <div class="text-xs text-slate-400 uppercase tracking-wider mt-1">{t('spec.spreaders')}</div>
          </div>
          <div>
            <div class="text-2xl sm:text-3xl font-black text-emerald-400">500 m</div>
            <div class="text-xs text-slate-400 uppercase tracking-wider mt-1">{t('spec.distance')}</div>
          </div>
        </div>

        <!-- Precizne lokacijske entitete (semantički LLM markeri) -->
        <div class="mt-6 max-w-xl rounded-xl border border-slate-800 bg-slate-900/60 p-4 space-y-2.5">
          <div class="flex items-start gap-3 text-xs sm:text-sm text-slate-300 leading-relaxed">
            <svg class="w-4 h-4 text-emerald-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
            </svg>
            <span>{t('loc.ferry')}</span>
          </div>
          <div class="flex items-start gap-3 text-xs sm:text-sm text-slate-300 leading-relaxed">
            <svg class="w-4 h-4 text-emerald-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 6.5a3.5 3.5 0 01-5.27 3.08l-4.9 2.36a3.5 3.5 0 010 6.12l4.9 2.36A3.5 3.5 0 1121 23.5a3.5 3.5 0 01-1.43-6.72l-4.9-2.36a3.5 3.5 0 010-6.84l4.9-2.36A3.5 3.5 0 1121 6.5zM17 5V3m2 2h2a2 2 0 012 2M17 17v2m-2-2h-2a2 2 0 00-2 2m8.5-7.5h.01M4 20h6"/>
            </svg>
            <span>{t('loc.korkyra')}</span>
          </div>
          <div class="flex items-start gap-3 text-xs sm:text-sm text-slate-300 leading-relaxed">
            <svg class="w-4 h-4 text-emerald-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"/>
            </svg>
            <span>{t('loc.area')}</span>
          </div>
        </div>

        <!-- CTA Gumbi -->
        <div class="mt-8 flex flex-wrap gap-4 items-center">
          <a
            href={`https://wa.me/${phoneRaw}?text=${whatsappMsg}`}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2.5 px-6 py-3.5 bg-[#25D366] hover:bg-[#20ba5a] text-white font-bold rounded-xl shadow-lg transition-transform hover:-translate-y-0.5 text-sm"
          >
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
              <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/>
            </svg>
            <span>{t('cta.whatsapp')}</span>
          </a>

          <a
            href={`tel:+${phoneRaw}`}
            class="inline-flex items-center gap-2.5 px-6 py-3.5 bg-slate-900 hover:bg-slate-800 text-white font-bold rounded-xl border border-slate-700 shadow-lg transition-transform hover:-translate-y-0.5 text-sm"
          >
            <svg class="w-5 h-5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
            </svg>
            <span>{phoneDisplay}</span>
          </a>
        </div>
      </div>

      <!-- Kran u akciji: kamionski kran Scania F600 AXP (16 t, 3 širilice) -->
      <div class="lg:col-span-5">
        <div class="relative w-full rounded-2xl overflow-hidden shadow-2xl border border-slate-800 bg-slate-900">
          <Image
            src={imgKran}
            alt="Kamionski kran Scania F600 AXP od 16 tona s 3 širilice diže jedrilicu u Veloj Luci"
            widths={[360, 450]}
            sizes="(max-width: 1023px) calc(100vw - 2rem), 490px"
            class="w-full h-full object-cover"
            format="webp"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-slate-950/70 via-transparent to-transparent pointer-events-none"></div>
          <div class="absolute bottom-3 left-4 right-4 flex items-center justify-between text-xs text-slate-300 font-medium pointer-events-none">
            <span>16 t Scania F600 AXP • {spreadersText}</span>
            <span class="bg-black/60 px-2 py-0.5 rounded font-mono">3 širilice</span>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
