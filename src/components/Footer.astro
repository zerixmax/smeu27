---
import { Image } from 'astro:assets';
import { useTranslations } from '../i18n/ui';
import logoProizd from '../assets/logos/logo-proizd-team-2019-web2.png';
import projectVersion from '../data/version.json';

interface Props {
  lang?: 'hr' | 'en' | 'de';
}

const { lang = 'hr' } = Astro.props;
const t = useTranslations(lang);
const phoneDisplay = "+385 98 954 03 88";
const phoneRaw = "385989540388";
const whatsappMsg = encodeURIComponent(t('cta.whatsapp_msg'));
const whatsappUrl = `https://wa.me/${phoneRaw}?text=${whatsappMsg}`;
const facebookUrl = "https://www.facebook.com/proizd";
const instagramUrl = "https://www.instagram.com/suhamarinaeu/";
---

<footer id="kontakt" class="mt-auto bg-slate-900 text-slate-300 border-t border-slate-800 pt-16 pb-24 md:pb-12 text-sm">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-10 pb-12 border-b border-slate-800">
      
      <div>
        <Image src={logoProizd} alt="PROIZD team" class="h-10 w-auto object-contain mb-4" />
        <p class="text-xs text-slate-400 leading-relaxed">
          {t('footer.about_line1')}<br />
          {t('footer.about_line2')}<br />
          {t('footer.about_line3')}
        </p>

        <!-- Društvene mreže: Facebook, Instagram, WhatsApp -->
        <div class="flex items-center gap-2.5 mt-4">
          <a
            href={facebookUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Facebook"
            class="w-8 h-8 rounded-lg bg-slate-900 border border-slate-800 flex items-center justify-center text-slate-400 hover:text-white hover:border-slate-700 transition-colors"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z"/>
            </svg>
          </a>
          <a
            href={instagramUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Instagram"
            class="w-8 h-8 rounded-lg bg-slate-900 border border-slate-800 flex items-center justify-center text-slate-400 hover:text-white hover:border-slate-700 transition-colors"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12.315 2c2.43 0 2.784.013 3.808.06 1.064.049 1.791.218 2.427.465a4.902 4.902 0 011.772 1.153 4.902 4.902 0 011.153 1.772c.247.636.416 1.363.465 2.427.048 1.067.06 1.407.06 4.123v.08c0 2.643-.012 2.987-.06 4.043-.049 1.064-.218 1.791-.465 2.427a4.902 4.902 0 01-1.153 1.772 4.902 4.902 0 01-1.772 1.153c-.636.247-1.363.416-2.427.465-1.067.048-1.407.06-4.123.06h-.08c-2.643 0-2.987-.012-4.043-.06-1.064-.049-1.791-.218-2.427-.465a4.902 4.902 0 01-1.772-1.153 4.902 4.902 0 01-1.153-1.772c-.247-.636-.416-1.363-.465-2.427-.047-1.024-.06-1.379-.06-3.808v-.63c0-2.43.013-2.784.06-3.808.049-1.064.218-1.791.465-2.427a4.902 4.902 0 011.153-1.772A4.902 4.902 0 015.45 2.525c.636-.247 1.363-.416 2.427-.465C8.901 2.013 9.256 2 11.685 2h.63zm-.081 1.802h-.468c-2.456 0-2.784.011-3.807.058-.975.045-1.504.207-1.857.344-.467.182-.8.398-1.15.748-.35.35-.566.683-.748 1.15-.137.353-.3.882-.344 1.857-.047 1.023-.058 1.351-.058 3.807v.468c0 2.456.011 2.784.058 3.807.045.975.207 1.504.344 1.857.182.466.399.8.748 1.15.35.35.683.566 1.15.748.353.137.882.3 1.857.344 1.054.048 1.37.058 4.041.058h.08c2.597 0 2.917-.01 3.96-.058.976-.045 1.505-.207 1.858-.344.466-.182.8-.398 1.15-.748.35-.35.566-.683.748-1.15.137-.353.3-.882.344-1.857.048-1.055.058-1.37.058-4.041v-.08c0-2.597-.01-2.917-.058-3.96-.045-.976-.207-1.505-.344-1.858a3.097 3.097 0 00-.748-1.15 3.098 3.098 0 00-1.15-.748c-.353-.137-.882-.3-1.857-.344-1.023-.047-1.351-.058-3.807-.058zM12 6.865a5.135 5.135 0 110 10.27 5.135 5.135 0 010-10.27zm0 1.802a3.333 3.333 0 100 6.666 3.333 3.333 0 000-6.666zm5.338-3.205a1.2 1.2 0 110 2.4 1.2 1.2 0 010-2.4z"/>
            </svg>
          </a>
          <a
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="WhatsApp"
            class="w-8 h-8 rounded-lg bg-slate-900 border border-slate-800 flex items-center justify-center text-emerald-400 hover:text-emerald-300 hover:border-emerald-500/40 transition-colors"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/>
            </svg>
          </a>
        </div>
      </div>

      <div>
        <h4 class="text-xs uppercase tracking-wider text-slate-300 font-bold mb-3">{t('footer.contacts')}</h4>
        <div class="space-y-1.5 text-xs">
          <p>{t('footer.address_label')} <span class="text-slate-200 font-medium">Ulica 41, br. 42, 20270 Vela Luka</span></p>
          <p>{t('footer.primary')} <a href={`tel:+${phoneRaw}`} class="text-white font-bold hover:underline">{phoneDisplay}</a></p>
          <p>{t('footer.additional')} <span class="text-slate-300">+385 91 560 4260</span></p>
          <p>{t('footer.additional')} <span class="text-slate-300">+385 91 928 6935</span></p>
          <p>{t('footer.email_label')} <a href="mailto:nikola.mul@gmail.com" class="text-emerald-400 hover:underline">nikola.mul@gmail.com</a></p>
        </div>
      </div>

      <div>
        <h4 class="text-xs uppercase tracking-wider text-slate-300 font-bold mb-3">{t('footer.compliance')}</h4>
        <div class="space-y-1 text-xs">
          <p><a href="/objava-cjenika" class="text-slate-300 hover:text-white underline">{t('footer.official_publish')}</a></p>
          <p><a href="/cjenik-download.csv" class="text-slate-400 hover:text-white">{t('footer.download_csv')}</a></p>
        </div>
      </div>

      <div>
        <h4 class="text-xs uppercase tracking-wider text-slate-300 font-bold mb-3">{t('footer.services')}</h4>
        <ul class="space-y-1.5 text-xs list-none">
          <li>
            <a
              href="/servis-i-dijagnostika-brodskih-motora"
              class="text-slate-400 hover:text-emerald-400 transition-colors"
            >
              {t('footer.link_engines')}
            </a>
          </li>
          <li>
            <a
              href="/ugradnja-minn-kota-garmin-force-korcula"
              class="text-slate-400 hover:text-emerald-400 transition-colors"
            >
              {t('footer.link_electronics')}
            </a>
          </li>
          <li>
            <a
              href="/podvodni-radovi-i-hrb-pregledi-korcula"
              class="text-slate-400 hover:text-emerald-400 transition-colors"
            >
              {t('footer.link_underwater')}
            </a>
          </li>
        </ul>
      </div>

    </div>

    <!-- Donja traka: Copyright + OleaD potpis + Verzioniranje aplikacije -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between text-xs gap-4">
      <div>
        © 2026 Obrt Proizd - Vela Luka. {t('footer.rights')}
      </div>

      <div class="flex items-center gap-3">
        <span>
          Izrada i održavanje: <a href="https://olead.hr" target="_blank" rel="noopener" class="text-slate-300 hover:text-white transition-colors font-medium">OleaD</a>
        </span>
        
        <span class="text-slate-700">•</span>

        <!-- Interna razvojna verzija (Vidljiva na webu) -->
        <span 
          class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-md bg-slate-900 border border-slate-800 text-[11px] font-mono text-slate-400"
          title={`Build ${projectVersion.build} • ${projectVersion.date}`}
        >
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
          v{projectVersion.version}
        </span>
      </div>
    </div>
  </div>
</footer>
