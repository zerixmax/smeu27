---
import { Image, getImage } from 'astro:assets';
import { useTranslations } from '../i18n/ui';

import imgKran from '../assets/images/gallery/7-suha-marina-vela-luka-2022.jpeg';
import imgHangarDron from '../assets/images/gallery/suha-marina-eu-vela-luka-dron-JPG.jpg';
import imgDronAlt from '../assets/images/gallery/suha-marina-eu-vela-luka-dron_16.jpg';
import imgVezCamci from '../assets/images/gallery/suha_marina_vela_luka_prevoz_plovila.jpg';
import imgServis from '../assets/images/gallery/servis_motora.jpg';
import imgDron16 from '../assets/images/gallery/suha-marina-eu-vela-luka-dron_16-hires.jpg';
import imgServisBase from '../assets/images/gallery/suha-marina-eu-servis-motora.jpg';
import imgServis02 from '../assets/images/gallery/suha-marina-eu-servis-motora_02.jpg';
import imgServis03 from '../assets/images/gallery/suha-marina-eu-servis-motora_03.jpg';
import imgServis05 from '../assets/images/gallery/suha-marina-eu-servis-motora_05.jpg';
import imgServis06 from '../assets/images/gallery/suha-marina-eu-servis-motora_06.jpg';
import imgServis07 from '../assets/images/gallery/suha-marina-eu-servis-motora_07.jpg';
import imgServis08 from '../assets/images/gallery/suha-marina-eu-servis-motora_08.jpg';
import imgServis10 from '../assets/images/gallery/suha-marina-eu-servis-motora_10.jpg';
import imgServis14 from '../assets/images/gallery/suha-marina-eu-servis-motora_14.jpg';
import imgServis15 from '../assets/images/gallery/suha-marina-eu-servis-motora_15.jpg';
import imgServis17 from '../assets/images/gallery/suha-marina-eu-servis-motora_17.jpg';
import imgDron14 from '../assets/images/gallery/suha-marina-eu-vela-luka-dron_14-JPG.jpg';
import imgDron15 from '../assets/images/gallery/suha-marina-eu-vela-luka-dron_15-JPG.jpg';
import imgDron26 from '../assets/images/gallery/suha-marina-eu-vela-luka-dron_26-JPG.jpg';
import imgDron27 from '../assets/images/gallery/suha-marina-eu-vela-luka-dron_27-JPG.jpg';
import imgPluća from '../assets/images/gallery/suha-marina-vela-luka-2022.jpeg';
import imgPluća2 from '../assets/images/gallery/suha-marina-vela-luka-2022_02.jpeg';
import imgPluća3 from '../assets/images/gallery/suha-marina-vela-luka-2022_03.jpeg';
import imgPlucaAlt from '../assets/images/gallery/suha-marina-vela-luka-2022_092_1.png';

interface Props {
  lang?: 'hr' | 'en' | 'de';
}

const { lang = 'hr' } = Astro.props;
const t = useTranslations(lang);

const headers = {
  hr: {
    title: "Rad na terenu i infrastruktura",
    desc: "Uvid u operacije vađenja kranom, halu i smještajni prostor u Veloj Luci."
  },
  en: {
    title: "Operations & Infrastructure",
    desc: "Glimpse into our crane lifts, workshop, and boat storage in Vela Luka."
  },
  de: {
    title: "Einsatz & Infrastruktur",
    desc: "Einblick in Kranarbeiten, Bootshalle und Stellplätze in Vela Luka."
  }
};

const current = headers[lang] || headers.hr;

// Alt opisi po serijama snimaka. NAPOMENA: generirani su iz imena datoteka i
// nisu ručno opisani pojedinačno — treba ih pregledati uz stvarne fotografije.
const seriesAlt = {
  kran: {
    hr: "Kamionski kran Scania 16 t diže jedrilicu u Veloj Luci",
    en: "Scania 16 t truck crane lifting a sailboat in Vela Luka",
    de: "Scania-LKW-Kran mit 16 t hebt eine Segelyacht in Vela Luka"
  },
  hangar: {
    hr: "Zračna snimka hangara i parcele suhe marine Proizd",
    en: "Aerial view of the Proizd dry dock hangar and yard",
    de: "Luftaufnahme der Proizd-Halle und des Lagerplatzes"
  },
  vez: {
    hr: "Brodovi na postoljima i trajlerima pod ceradom",
    en: "Boats on cradles and trailers under the canopy",
    de: "Boote auf Lagern und Anhängern unter der Plane"
  },
  servis: {
    hr: "Servisna radionica i rad na motorima brodova",
    en: "Service workshop and boat engine work",
    de: "Servicewerkstatt und Arbeiten an Bootmotoren"
  },
  dron: {
    hr: "Zračna snimka suhe marine Proizd u Veloj Luci",
    en: "Aerial view of the Proizd dry dock in Vela Luka",
    de: "Luftaufnahme der Trockenmarina Proizd in Vela Luka"
  },
  pluca: {
    hr: "Brodovi na plićaku i u luci Vela Luka",
    en: "Boats on the shallows and in the Vela Luka harbour",
    de: "Boote auf der Flachwasserzone und im Hafen von Vela Luka"
  }
};

type Series = keyof typeof seriesAlt;

const sources: { id: string; src: ImageMetadata; series: Series }[] = [
  { id: 'kran', src: imgKran, series: 'kran' },
  { id: 'servis-rad', src: imgServisBase, series: 'servis' },
  { id: 'servis-02', src: imgServis02, series: 'servis' },
  { id: 'servis-03', src: imgServis03, series: 'servis' },
  { id: 'servis-05', src: imgServis05, series: 'servis' },
  { id: 'servis-06', src: imgServis06, series: 'servis' },
  { id: 'servis-07', src: imgServis07, series: 'servis' },
  { id: 'servis-08', src: imgServis08, series: 'servis' },
  { id: 'servis-10', src: imgServis10, series: 'servis' },
  { id: 'servis-14', src: imgServis14, series: 'servis' },
  { id: 'servis-15', src: imgServis15, series: 'servis' },
  { id: 'servis-17', src: imgServis17, series: 'servis' },
  { id: 'servis-stari', src: imgServis, series: 'servis' },
  { id: 'hangar', src: imgHangarDron, series: 'hangar' },
  { id: 'dron-otvoreni', src: imgDronAlt, series: 'dron' },
  { id: 'dron-14', src: imgDron14, series: 'dron' },
  { id: 'dron-15', src: imgDron15, series: 'dron' },
  { id: 'dron-16', src: imgDron16, series: 'dron' },
  { id: 'dron-26', src: imgDron26, series: 'dron' },
  { id: 'dron-27', src: imgDron27, series: 'dron' },
  { id: 'vez', src: imgVezCamci, series: 'vez' },
  { id: 'pluca', src: imgPluća, series: 'pluca' },
  { id: 'pluca-02', src: imgPluća2, series: 'pluca' },
  { id: 'pluca-03', src: imgPluća3, series: 'pluca' },
  { id: 'pluca-dron', src: imgPlucaAlt, series: 'pluca' }
];

const items = sources.map((s) => ({
  id: s.id,
  src: s.src,
  alt: seriesAlt[s.series][lang] || seriesAlt[s.series].hr
}));

// Lightbox: webp bez upscale-a, ali najviše 1600 px širine da 25 slika
// ne zauzima nekoliko MB u dist/ (učitavaju se tek pri otvaranju).
const LIGHTBOX_MAX = 1600;
// Koliko slika se prikazuje u mreži. Ostatak ostaje u HTML-u (skriven preko
// hidden) pa se ne učitava niti ne zauzima mjesto, a lightbox navigira samo
// kroz vidljivih SHOWN. Izbor je nasumičan po sesiji → iste 6 nisu stalno.
const SHOWN = 6;
const lightbox = await Promise.all(
  items.map(async (item) => {
    const width = Math.min(item.src.width, LIGHTBOX_MAX);
    const img = await getImage({ src: item.src, width, format: 'webp', quality: 85 });
    return {
      id: item.id,
      src: img.src,
      width: img.attributes.width,
      height: img.attributes.height,
      alt: item.alt
    };
  })
);
---

<!-- Galerija -->
<section id="galerija" class="py-20 border-b border-slate-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="mb-12">
      <h2 class="text-3xl font-black text-white">{current.title}</h2>
      <p class="text-slate-400 text-sm mt-1">{current.desc}</p>
      <p class="text-slate-500 text-xs mt-1">
        {t('gallery.shown')} {SHOWN} {t('gallery.ofTotal')} {items.length}
      </p>
    </div>

    <!-- Masonry (CSS columns): portretne snimke zadržavaju prirodni omjer,
         landscape se ne razvlači, a nema praznih ćelija u mreži. -->
    <div class="columns-2 md:columns-3 gap-4" data-gallery-grid>
      {items.map((item, i) => (
        <button
          type="button"
          class="mb-4 w-full break-inside-avoid rounded-xl overflow-hidden border border-slate-800 group relative cursor-zoom-in focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-500"
          data-gallery-item={i}
          aria-label={`${t('gallery.open')} ${i + 1} ${t('gallery.of')} ${items.length}: ${item.alt}`}
        >
          <Image
            src={item.src}
            alt={item.alt}
            widths={[240, 360, 480]}
            sizes="(max-width: 767px) 50vw, (max-width: 1023px) 33vw, 380px"
            format="webp"
            loading="lazy"
            decoding="async"
            class="w-full h-auto block group-hover:scale-105 transition-transform duration-300"
          />
          <span class="absolute inset-0 bg-slate-950/0 group-hover:bg-slate-950/20 transition-colors duration-300 pointer-events-none"></span>
          <span class="absolute bottom-2 right-2 w-8 h-8 rounded-lg bg-slate-950/70 backdrop-blur-sm border border-white/10 text-white flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-4.35-4.35M17 10a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
          </span>
        </button>
      ))}
    </div>
  </div>
</section>

<!-- Lightbox -->
<div
  id="gallery-lightbox"
  class="fixed inset-0 z-[100] hidden items-center justify-center bg-slate-950/95 backdrop-blur-sm p-4 sm:p-8"
  role="dialog"
  aria-modal="true"
  aria-label={t('gallery.label')}
>
  <button type="button" id="gallery-lb-close" class="absolute top-4 right-4 sm:top-6 sm:right-6 w-11 h-11 rounded-xl bg-white/5 hover:bg-white/10 border border-white/10 text-white flex items-center justify-center transition-colors" aria-label={t('gallery.close')}>
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
  </button>

  <button type="button" id="gallery-lb-prev" class="absolute left-2 sm:left-6 w-11 h-11 rounded-xl bg-white/5 hover:bg-white/10 border border-white/10 text-white flex items-center justify-center transition-colors" aria-label={t('gallery.prev')}>
    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
  </button>

  <button type="button" id="gallery-lb-next" class="absolute right-2 sm:right-6 w-11 h-11 rounded-xl bg-white/5 hover:bg-white/10 border border-white/10 text-white flex items-center justify-center transition-colors" aria-label={t('gallery.next')}>
    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
  </button>

  <figure class="max-w-full max-h-full flex flex-col items-center justify-center gap-3 pointer-events-none">
    <img id="gallery-lb-img" src="" alt="" class="max-w-full max-h-[78vh] object-contain rounded-lg shadow-2xl" />
    <figcaption class="text-center">
      <p id="gallery-lb-caption" class="text-sm text-slate-300 max-w-2xl"></p>
      <p id="gallery-lb-counter" class="text-xs font-mono text-slate-500 mt-1"></p>
    </figcaption>
  </figure>
</div>

<!-- Mreža ostaje nevidljiva dok skripta ne odabere koje 6 slika ide na
     stranicu (inače bi se na sporijim uređajima bljesnulo svih 25). Prostor je
     rezerviran (visibility, ne display) pa nema skoka izgleda. -->
<style is:global>
  html:not(.gallery-ready) [data-gallery-grid] { visibility: hidden; }
</style>

<script is:inline define:vars={{ lightboxData: lightbox, shownCount: SHOWN, openLabel: t('gallery.open'), ofLabel: t('gallery.of') }}>
  window.__galleryInit = window.__galleryInit || function () {
    const SHOWN = shownCount;
    const lb = document.getElementById('gallery-lightbox');
    const grid = document.querySelector('[data-gallery-grid]');
    const data = lightboxData;
    if (!lb || !grid) return;

    const img = document.getElementById('gallery-lb-img');
    const caption = document.getElementById('gallery-lb-caption');
    const counter = document.getElementById('gallery-lb-counter');
    const btnClose = document.getElementById('gallery-lb-close');
    const btnPrev = document.getElementById('gallery-lb-prev');
    const btnNext = document.getElementById('gallery-lb-next');
    const all = Array.from(grid.querySelectorAll('[data-gallery-item]'));
    const total = data.length;
    let index = 0;
    let lastFocused = null;

    // Lightbox lista SVE slike (odabrane u ovoj sesiji), ne samo vidljivih 6.
    const show = (i) => {
      index = (i + total) % total;
      const item = data[index];
      if (!item) return;
      img.src = item.src;
      img.alt = item.alt;
      img.width = item.width;
      img.height = item.height;
      caption.textContent = item.alt;
      counter.textContent = (index + 1) + ' / ' + total;
    };

    const open = (i) => {
      show(i);
      lb.classList.remove('hidden');
      lb.classList.add('flex');
      document.body.style.overflow = 'hidden';
      lastFocused = document.activeElement;
      btnClose.focus();
    };

    const close = () => {
      lb.classList.add('hidden');
      lb.classList.remove('flex');
      document.body.style.overflow = '';
      img.src = '';
      if (lastFocused && lastFocused.focus) lastFocused.focus();
    };

    grid.addEventListener('click', (e) => {
      const btn = e.target.closest('[data-gallery-item]');
      if (btn) open(Number(btn.dataset.galleryItem));
    });

    btnClose.addEventListener('click', close);
    btnPrev.addEventListener('click', () => show(index - 1));
    btnNext.addEventListener('click', () => show(index + 1));

    lb.addEventListener('click', (e) => {
      if (e.target === lb) close();
    });

    // Tipkovnica se veže na document samo jednom po sesiji (ClientRouter inače
    // nakon svake SPA navigacije doda novi listener → dupli Escape/strelice).
    // Handler ne drži stari closure nego čita trenutno stanje iz __galleryKey.
    window.__galleryKey = { lb, show, close, buttons: [btnPrev, btnNext, btnClose], at: () => index };
    if (!window.__galleryKeydownBound) {
      window.__galleryKeydownBound = true;
      document.addEventListener('keydown', (e) => {
        const g = window.__galleryKey;
        if (!g || !g.lb || g.lb.classList.contains('hidden')) return;
        if (e.key === 'Escape') g.close();
        else if (e.key === 'ArrowLeft') g.show(g.at() - 1);
        else if (e.key === 'ArrowRight') g.show(g.at() + 1);
        else if (e.key === 'Tab') {
          e.preventDefault();
          const pos = g.buttons.indexOf(document.activeElement);
          g.buttons[(pos + 1) % g.buttons.length].focus();
        }
      });
    }

    // Rotacija: nasumičan redoslijed svih slika, ali na stranici se prikazuje
    // samo SHOWN nasumično odabranih. Odabir se sprema u sessionStorage da
    // SPA navigacija ne promijeni 6 slika usred pregledavanja. Kod starih
    // posjećenih sesija duljina se razlikuje pa se spremnik poništi.
    let order = null;
    try { order = JSON.parse(sessionStorage.getItem('gallery-order') || 'null'); } catch (err) { order = null; }
    if (!Array.isArray(order) || order.length !== all.length) {
      order = all.map((_, i) => i);
      for (let i = order.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [order[i], order[j]] = [order[j], order[i]];
      }
      try { sessionStorage.setItem('gallery-order', JSON.stringify(order)); } catch (err) { /* privatni mod */ }
    }

    // order[p] = izvorni indeks na poziciji p. `data-gallery-item` nosi poziciju
    // u rotiranom redoslijedu (0..24) pa lightbox zna koju sliku je otvoreno;
    // elementi poslije SHOWN se premještaju na kraj mreže i skrivaju
    // (hidden = nema ni mjesta ni učitavanja, nisu ni u a11y stablu).
    const visible = order.slice(0, SHOWN);
    const hidden = order.slice(SHOWN);
    visible.concat(hidden).forEach((originalIndex, pos) => {
      const el = all[originalIndex];
      el.dataset.galleryItem = String(pos);
      if (pos >= SHOWN) {
        el.hidden = true;
        grid.appendChild(el);
      }
      if (pos < SHOWN) {
        el.setAttribute(
          'aria-label',
          `${openLabel} ${pos + 1} ${ofLabel} ${total}: ${el.getAttribute('alt') || ''}`
        );
      }
    });
    document.documentElement.classList.add('gallery-ready');
  };
  if (!window.__galleryPageLoadBound) {
    window.__galleryPageLoadBound = true;
    document.addEventListener('astro:page-load', window.__galleryInit);
  }
</script>