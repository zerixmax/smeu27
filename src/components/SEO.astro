---
import { ClientRouter } from 'astro:transitions';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  lang?: 'hr' | 'en' | 'de';
}

const {
  title = "Suha Marina Proizd | Suhi Vez i Servis Brodova Vela Luka",
  description = "Suha marina Proizd u Veloj Luci na Korčuli (500 m od mora). Čuvanje brodova, kamionski kran 16 t s 3 širilice za brage, servis motora i popravci stakloplastike.",
  image = "/og-image.jpg",
  lang = 'hr'
} = Astro.props;

const site = Astro.site ?? new URL('https://suhamarina.eu/');
const base = site.toString().replace(/\/+$/, '');

const ogLocale = lang === 'en' ? 'en_GB' : lang === 'de' ? 'de_DE' : 'hr_HR';
// Bez locale prefixa — samo su naslovne stranice lokalizirane (vidjeti Navbar.astro)
const canonical = new URL(Astro.url.pathname, site).href;
// Absolute URL ključan za WhatsApp/Facebook scraper — relativne putanje se odbacuju
const ogImageURL = new URL(image, site).href;
const ogImageType = image.toLowerCase().endsWith('.png') ? 'image/png' : 'image/jpeg';
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{title}</title>
<meta name="description" content={description} />
<meta name="theme-color" content="#020617" />
<link rel="canonical" href={canonical} />

<!-- Favicon -->
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="alternate icon" type="image/x-icon" href="/favicon.ico" />

<!-- i18n hreflang -->
<link rel="alternate" hreflang="hr" href={`${base}/`} />
<link rel="alternate" hreflang="en" href={`${base}/en/`} />
<link rel="alternate" hreflang="de" href={`${base}/de/`} />
<link rel="alternate" hreflang="x-default" href={`${base}/`} />

<!-- Open Graph -->
<meta property="og:type" content="website" />
<meta property="og:site_name" content="Suha Marina Proizd" />
<meta property="og:locale" content={ogLocale} />
<meta property="og:locale:alternate" content="hr_HR" />
<meta property="og:locale:alternate" content="en_GB" />
<meta property="og:locale:alternate" content="de_DE" />
<meta property="og:url" content={canonical} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImageURL} />
<meta property="og:image:secure_url" content={ogImageURL} />
<meta property="og:image:type" content={ogImageType} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="Suha Marina Proizd - Vela Luka" />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonical} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageURL} />
<meta name="twitter:image:alt" content="Suha Marina Proizd - Vela Luka" />

<!-- Astro SOP: ClientRouter -->
<ClientRouter />