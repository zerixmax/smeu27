---
import { Image } from 'astro:assets';
import logoProizd from '../assets/logos/logo-proizd-team-2019-web2.png';
import { useTranslations } from '../i18n/ui';

interface Props {
  lang?: 'hr' | 'en' | 'de';
}

const { lang = 'hr' } = Astro.props;
const t = useTranslations(lang);

const phoneDisplay = "+385 98 954 03 88";
const phoneRaw = "385989540388";
const whatsappMsg = encodeURIComponent(t('cta.whatsapp_msg'));
const whatsappUrl = `https://wa.me/${phoneRaw}?text=${whatsappMsg}`;
const facebookUrl = "https://www.facebook.com/proizd";
const instagramUrl = "https://www.instagram.com/suhamarinaeu/";
const homePrefix = lang === 'hr' ? '/' : `/${lang}/`;

// Lokalizirane su samo naslovne stranice; sve ostale rute su isključivo HR,
// stoga prebacivač jezika uvijek vodi na odgovarajuću lokaliziranu početnu.
function getLocalizedPath(targetLang: string) {
  if (targetLang === 'hr') return '/';
  return `/${targetLang}/`;
}
---

<header class="sticky top-0 z-40 bg-white/95 backdrop-blur-md border-b border-slate-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-24 flex items-center justify-between gap-4">
    
    <!-- Logo PROIZD team -->
    <a href={homePrefix} class="flex items-center gap-3 group shrink-0">
      <Image 
        src={logoProizd} 
        alt="PROIZD team logo - Profesionalni marinski servis Vela Luka" 
        class="h-16 md:h-20 w-auto object-contain transition-transform group-hover:scale-105"
        loading="eager"
      />
    </a>

    <!-- Desktop Navigacija -->
    <nav class="hidden lg:flex items-center gap-5 xl:gap-6 text-sm font-semibold text-slate-700">
      <a href={`${homePrefix}#usluge`} class="text-slate-700 hover:text-sky-700 font-semibold transition-colors">{t('nav.services')}</a>
      <a href={`${homePrefix}#kran`} class="text-slate-700 hover:text-sky-700 font-semibold transition-colors">{t('nav.crane')}</a>
      <a
        href="/ugradnja-minn-kota-garmin-force-korcula"
        class="text-sky-800 hover:text-sky-700 transition-colors font-semibold"
      >
        {t('nav.electronics')}
      </a>
      <a href={`${homePrefix}#galerija`} class="text-slate-700 hover:text-sky-700 font-semibold transition-colors">{t('nav.gallery')}</a>
      <a href={`${homePrefix}#cjenik`} class="text-slate-700 hover:text-sky-700 font-semibold transition-colors">{t('nav.prices')}</a>
      <a href={`${homePrefix}#kontakt`} class="text-slate-700 hover:text-sky-700 font-semibold transition-colors">{t('nav.contact')}</a>
    </nav>

    <!-- Desktop: Društvene mreže, Jezici & Brzi Poziv -->
    <div class="hidden md:flex items-center gap-3">
      <!-- Društvene mreže (Facebook, Instagram, WhatsApp) — skrivene na lg zbog većeg loga -->
      <div class="hidden xl:flex items-center gap-1.5 pr-1 border-r border-slate-200">
        <a
          href={facebookUrl}
          target="_blank"
          rel="noopener noreferrer"
