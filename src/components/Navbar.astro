---
import { Image } from 'astro:assets';
import logoProizd from '../assets/logos/logo-proizd-team-2019-web2.png';
import { useTranslations } from '../i18n/ui';

interface Props {
  lang?: 'hr' | 'en' | 'de';
}

const { lang = 'hr' } = Astro.props;
const t = useTranslations(lang);

const phoneDisplay = "+385 98 954 03 88";
const phoneRaw = "385989540388";

// Lokalizirane su samo naslovne stranice; sve ostale rute su isključivo HR,
// stoga prebacivač jezika uvijek vodi na odgovarajuću lokaliziranu početnu.
function getLocalizedPath(targetLang: string) {
  if (targetLang === 'hr') return '/';
  return `/${targetLang}/`;
}
---

<header class="sticky top-0 z-40 bg-slate-950/95 backdrop-blur-md border-b border-slate-800/80">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
    
    <!-- Logo PROIZD team -->
    <a href={lang === 'hr' ? '/' : `/${lang}/`} class="flex items-center gap-3 group">
      <Image 
        src={logoProizd} 
        alt="PROIZD team logo - Profesionalni marinski servis Vela Luka" 
        class="h-11 sm:h-12 w-auto object-contain transition-transform group-hover:scale-105"
        loading="eager"
      />
    </a>

    <!-- Desktop Navigacija -->
    <nav class="hidden md:flex items-center gap-7 text-sm font-medium text-slate-300">
      <a href="#usluge" class="hover:text-red-500 transition-colors">{t('nav.services')}</a>
      <a href="#kran" class="hover:text-red-500 transition-colors">{t('nav.crane')}</a>
      <a href="#galerija" class="hover:text-red-500 transition-colors">{t('nav.gallery')}</a>
      <a href="#cjenik" class="hover:text-red-500 transition-colors">{t('nav.prices')}</a>
      <a href="#kontakt" class="hover:text-red-500 transition-colors">{t('nav.contact')}</a>
    </nav>

    <!-- Desktop: Jezici & Brzi Poziv -->
    <div class="hidden md:flex items-center gap-4">
      <div class="flex items-center text-xs font-semibold bg-slate-900 border border-slate-800 rounded-lg p-1">
        <a 
          href={getLocalizedPath('hr')} 
          class={`px-2 py-1 rounded transition-colors ${lang === 'hr' ? 'bg-red-600 text-white shadow-xs' : 'text-slate-400 hover:text-white'}`}
        >HR</a>
        <a 
          href={getLocalizedPath('en')} 
          class={`px-2 py-1 rounded transition-colors ${lang === 'en' ? 'bg-red-600 text-white shadow-xs' : 'text-slate-400 hover:text-white'}`}
        >EN</a>
        <a 
          href={getLocalizedPath('de')} 
          class={`px-2 py-1 rounded transition-colors ${lang === 'de' ? 'bg-red-600 text-white shadow-xs' : 'text-slate-400 hover:text-white'}`}
        >DE</a>
      </div>

      <a
        href={`tel:+${phoneRaw}`}
        class="inline-flex items-center gap-2 px-3.5 py-2 bg-slate-900 hover:bg-slate-800 text-white font-semibold text-xs rounded-xl border border-slate-700 shadow-sm transition-all"
      >
        <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
        </svg>
        <span>{phoneDisplay}</span>
      </a>
    </div>

    <!-- Mobilni Burger Gumb (Vidljiv samo na < md) -->
    <div class="flex items-center gap-2 md:hidden">
      <!-- Jezik na mobitelu uz burger -->
      <div class="flex items-center text-[11px] font-bold bg-slate-900 border border-slate-800 rounded-lg p-0.5 mr-1">
        <a href={getLocalizedPath('hr')} class={`px-1.5 py-0.5 rounded ${lang === 'hr' ? 'bg-red-600 text-white' : 'text-slate-400'}`}>HR</a>
        <a href={getLocalizedPath('en')} class={`px-1.5 py-0.5 rounded ${lang === 'en' ? 'bg-red-600 text-white' : 'text-slate-400'}`}>EN</a>
        <a href={getLocalizedPath('de')} class={`px-1.5 py-0.5 rounded ${lang === 'de' ? 'bg-red-600 text-white' : 'text-slate-400'}`}>DE</a>
      </div>

      <button
        id="mobile-menu-toggle"
        type="button"
        class="inline-flex items-center justify-center p-2.5 rounded-xl bg-slate-900 border border-slate-800 text-slate-300 hover:text-white hover:bg-slate-800 focus:outline-none transition-all active:scale-95"
        aria-controls="mobile-menu"
        aria-expanded="false"
        aria-label={t('nav.menu_label')}
      >
        <!-- Ikona burgera (3 crtice) -->
        <svg id="burger-icon" class="w-6 h-6 block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
        <!-- Ikona zatvaranja (X) -->
        <svg id="close-icon" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>

  </div>

  <!-- Mobilni padajući Drawer / Menu -->
  <div 
    id="mobile-menu" 
    class="hidden md:hidden border-t border-slate-800/80 bg-slate-950/98 px-4 pt-3 pb-6 shadow-2xl transition-all"
  >
    <div class="flex flex-col space-y-3 font-medium text-base text-slate-300 pt-2">
      <a href="#usluge" class="mobile-nav-link px-3 py-2.5 rounded-xl hover:bg-slate-900 hover:text-red-500 transition-colors">
        {t('nav.services')}
      </a>
      <a href="#kran" class="mobile-nav-link px-3 py-2.5 rounded-xl hover:bg-slate-900 hover:text-red-500 transition-colors">
        {t('nav.crane')}
      </a>
      <a href="#galerija" class="mobile-nav-link px-3 py-2.5 rounded-xl hover:bg-slate-900 hover:text-red-500 transition-colors">
        {t('nav.gallery')}
      </a>
      <a href="#cjenik" class="mobile-nav-link px-3 py-2.5 rounded-xl hover:bg-slate-900 hover:text-red-500 transition-colors">
        {t('nav.prices')}
      </a>
      <a href="#kontakt" class="mobile-nav-link px-3 py-2.5 rounded-xl hover:bg-slate-900 hover:text-red-500 transition-colors">
        {t('nav.contact')}
      </a>
    </div>

    <!-- Dodatni podaci unutar mobilnog menija -->
    <div class="mt-6 pt-5 border-t border-slate-800/80 space-y-2 text-xs text-slate-400 px-3">
      <p class="text-white font-semibold flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
        Vela Luka, 500 m od mora
      </p>
      <p>Tel: <a href={`tel:+${phoneRaw}`} class="text-slate-200 font-bold">{phoneDisplay}</a></p>
      <p>Email: <a href="mailto:info@velalukarent.com" class="text-emerald-400">info@velalukarent.com</a></p>
    </div>
  </div>
</header>

<!-- Skripta usklađena s Astro SOP-om (astro:page-load) -->
<script>
  function setupMobileMenu() {
    const toggleBtn = document.getElementById('mobile-menu-toggle');
    const mobileMenu = document.getElementById('mobile-menu');
    const burgerIcon = document.getElementById('burger-icon');
    const closeIcon = document.getElementById('close-icon');
    const navLinks = document.querySelectorAll('.mobile-nav-link');

    if (!toggleBtn || !mobileMenu || !burgerIcon || !closeIcon) return;

    const btn = toggleBtn;
    const menu = mobileMenu;
    const burger = burgerIcon;
    const close = closeIcon;

    function toggleMenu() {
      const isExpanded = btn.getAttribute('aria-expanded') === 'true';
      const nextState = !isExpanded;

      btn.setAttribute('aria-expanded', String(nextState));
      menu.classList.toggle('hidden', !nextState);
      burger.classList.toggle('hidden', nextState);
      close.classList.toggle('hidden', !nextState);
    }

    function closeMenu() {
      btn.setAttribute('aria-expanded', 'false');
      menu.classList.add('hidden');
      burger.classList.remove('hidden');
      close.classList.add('hidden');
    }

    // Toggle klik
    btn.addEventListener('click', toggleMenu);

    // Automatsko zatvaranje izbornika kad korisnik klikne na bilo koji anchor link
    navLinks.forEach((link) => {
      link.addEventListener('click', closeMenu);
    });

    // Zatvaranje tipkom Escape
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') closeMenu();
    });
  }

  // Astro SOP: obavezno vezanje uz astro:page-load radi ClientRouter navigacije
  document.addEventListener('astro:page-load', setupMobileMenu);
</script>
