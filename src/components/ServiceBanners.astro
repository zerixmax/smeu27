const current = data[lang] ?? data.hr;
---

<section id="usluge" class="scroll-mt-24 bg-slate-100 py-10 sm:py-14">
  <div class="mx-auto max-w-7xl space-y-8 px-4 sm:space-y-10 sm:px-6 lg:px-8">
    {current.sections.map((sec, idx) => (
      <details
        id={sec.id}
        class={`group overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-md transition-all duration-300 ${sec.borderAccent}`}
      >
        <summary class="list-none cursor-pointer select-none [&::-webkit-details-marker]:hidden focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-sky-300/70">
          <div class="flex items-center justify-center bg-white px-6 pb-4 pt-6">
            <img
              src={sec.icon}
              alt={sec.iconAlt}
              width="320"
              height="320"
              loading="lazy"
              decoding="async"
              class="h-36 w-auto object-contain transition-transform duration-300 group-hover:scale-105 sm:h-44 md:h-48"
            />
          </div>

          <div class={`px-6 py-5 transition-colors ${sec.bannerBg}`}>
            <div class="flex items-start justify-between gap-4">
              <div class="space-y-1.5">
                <h2 class="text-xl font-black leading-snug tracking-tight sm:text-2xl">
                  {idx + 1}. {sec.title}
                </h2>
                <p class="max-w-2xl text-sm font-medium leading-relaxed opacity-95 sm:text-base">
                  {sec.shortSummary}
                </p>
                {sec.brands && (
                  <div class="flex flex-wrap gap-2 pt-2 text-xs font-black uppercase tracking-wider opacity-90">
                    {sec.brands.map((brand) => (
                      <span class="rounded bg-black/10 px-2 py-0.5">{brand}</span>
                    ))}
                  </div>
                )}
              </div>

              <span class="mt-1 flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-black/15 transition-transform duration-300 group-open:rotate-180">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
                </svg>
              </span>
            </div>
          </div>
        </summary>

        <div class="grid grid-cols-1 items-center gap-8 border-t border-slate-200 bg-white p-6 sm:p-8 lg:grid-cols-12">
          <div class="space-y-4 lg:col-span-7">
            <p class="text-base font-medium leading-relaxed text-slate-700">
              {sec.fullDescription}
            </p>

            <ul class="space-y-2.5 pt-2 text-sm text-slate-700 sm:text-base">
              {sec.bullets.map((bullet) => (
                <li class="flex items-start gap-2.5">
                  <span class="mt-0.5 font-black text-sky-700">✓</span>
                  <span>{bullet}</span>
                </li>
              ))}
            </ul>

            <div class="pt-4">
              <a
                href={sec.link}
                class="inline-flex items-center gap-2 rounded-xl bg-slate-900 px-5 py-3 text-sm font-bold text-white shadow-sm transition-colors hover:bg-sky-800"
              >
                <span>{sec.linkText}</span>
                <span aria-hidden="true">→</span>
              </a>
            </div>
          </div>

          <div class="lg:col-span-5">
            <div class="aspect-[4/3] overflow-hidden rounded-2xl border border-slate-200 bg-slate-100 shadow-sm">
              <Image
                src={sec.image}
                alt={sec.imageAlt}
                widths={[420, 640, 840]}
                sizes="(max-width: 1024px) 100vw, 40vw"
                class="h-full w-full object-cover"
                format="webp"
                loading="lazy"
                decoding="async"
              />
            </div>
          </div>
        </div>
      </details>
    ))}
  </div>
</section>

<script>
  const desktopQuery = window.matchMedia('(min-width: 768px)');

  function syncServiceBannersState() {
    const banners = document.querySelectorAll<HTMLDetailsElement>('#usluge details');

    banners.forEach((detail) => {
      if (desktopQuery.matches) {
        detail.setAttribute('open', '');
      } else {
        detail.removeAttribute('open');
      }
    });
  }

  syncServiceBannersState();
  // Ponovno pokreni nakon Astro ClientRouter navigacije i promjene breakpointa
  document.addEventListener('astro:page-load', syncServiceBannersState);
  desktopQuery.addEventListener('change', syncServiceBannersState);
</script>
