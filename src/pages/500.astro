---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<Layout 
  title="500 - Poslužiteljska greška | Suha Marina Proizd" 
  description="Došlo je do neočekivane pogreške na poslužitelju. Naš tim radi na otklanjanju problema."
  lang="hr"
>
  <Navbar lang="hr" />

  <main class="flex-1 flex items-center justify-center py-20 px-4 sm:px-6 lg:px-8 relative overflow-hidden bg-slate-50">
    <!-- Pozadinska mreža -->
    <div class="absolute inset-0 bg-grid-pattern opacity-40 pointer-events-none"></div>

    <div class="relative z-10 max-w-lg w-full text-center bg-white border border-slate-200 rounded-3xl p-8 sm:p-10 shadow-sm">
      <!-- Značka greške -->
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-sky-50 text-sky-800 border border-sky-200 text-xs font-semibold uppercase tracking-wider mb-6">
        <span class="w-2 h-2 rounded-full bg-sky-700"></span>
        Greška 500 • Tehnički problem
      </div>

      <!-- Brojka 500 u čvrstoj marinsko plavoj boji bez tekstualnog gradijenta -->
      <h1 class="text-7xl sm:text-9xl font-black font-mono tracking-tight text-sky-800 mb-4 select-none">
        500
      </h1>

      <!-- Naslov i opis -->
      <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 mb-3">
        Privremeni prekid veze
      </h2>
      
      <p class="text-slate-700 text-sm sm:text-base leading-relaxed mb-8">
        Došlo je do neočekivane poteškoće na poslužitelju. Pokušajte ponovno učitati stranicu ili nas kontaktirajte izravno telefonom.
      </p>

      <!-- Akcijski gumbi -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href="/"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3.5 bg-slate-100 hover:bg-slate-200 text-slate-800 font-bold rounded-xl border border-slate-200 shadow-sm transition-all text-sm group"
        >
          <svg class="w-4 h-4 transition-transform group-hover:-translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
          </svg>
          <span>Povratak na naslovnu</span>
        </a>

        <a
          href="tel:+385989540388"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3.5 bg-sky-800 hover:bg-sky-900 text-white font-bold rounded-xl shadow-sm transition-all text-sm"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
          </svg>
          <span>Hitni poziv: +385 98 954 03 88</span>
        </a>
      </div>
    </div>
  </main>

  <Footer lang="hr" />
</Layout>
