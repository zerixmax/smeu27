---
import { getImage } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

import imgPlanet from '../assets/images/gallery/planet-nova-2018.jpg';

// Pozadinska fotografija (1920×1896). Prebacuje se u webp bez upscale-a;
// učitava se lijeno jer je uklopljena u tamnu masku.
const backdrop = await getImage({
  src: imgPlanet,
  format: 'webp',
  quality: 60,
  widths: [960, 1440, 1920],
  sizes: '100vw'
});
---

<Layout 
  title="404 - Uplovili smo u krivu uvalu | Suha Marina Proizd" 
  description="Ova stranica ne postoji — uplovili smo u krivu uvalu. Vratite se na naslovnu stranicu Suha Marina Proizd u Veloj Luci na Korčuli."
  lang="hr"
>
  <Navbar lang="hr" />

  <main class="flex-1 flex items-center justify-center py-20 px-4 sm:px-6 lg:px-8 relative overflow-hidden bg-slate-50">
    <!-- Fotografija plaže i plovila kao pozadina -->
    <img
      src={backdrop.src}
      alt=""
      width={backdrop.attributes.width}
      height={backdrop.attributes.height}
      loading="lazy"
      decoding="async"
      class="absolute inset-0 w-full h-full object-cover opacity-15 grayscale"
    />
    <div class="absolute inset-0 bg-white/80 pointer-events-none"></div>

    <!-- Pozadinska mreža -->
    <div class="absolute inset-0 bg-grid-pattern opacity-40 pointer-events-none"></div>

    <div class="relative z-10 max-w-lg w-full text-center bg-white border border-slate-200 rounded-3xl p-8 sm:p-10 shadow-sm">
      <!-- Značka greške -->
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-sky-50 text-sky-800 border border-sky-200 text-xs font-semibold uppercase tracking-wider mb-6">
        <span class="w-2 h-2 rounded-full bg-sky-700"></span>
        Greška 404 • uplovili smo u krivu uvalu
      </div>

      <!-- Brojka 404 u čvrstoj marinsko plavoj boji bez tekstualnog gradijenta -->
      <h1 class="text-7xl sm:text-9xl font-black font-mono tracking-tight text-sky-800 mb-4 select-none">
        404
      </h1>

      <!-- Naslov i opis -->
      <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 mb-3">
        Ups, uplovili smo na krivu plažu!
      </h2>
      
      <p class="text-slate-700 text-sm sm:text-base leading-relaxed mb-8">
        Ova stranica ne postoji — <strong class="text-slate-900">doplovili smo u krivu uvalu</strong>.
        Naš GPS nam je danas odbio poslušnost, pa smo se poslijepili uz obalu i ispričavamo.
        Niste sami u ovome: dnevno krenemo u zlu luku. Vi samo nemate svoj kran za vađenje.
      </p>

      <!-- Akcijski gumbi -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href="/"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3.5 bg-sky-800 hover:bg-sky-900 text-white font-bold rounded-xl shadow-sm transition-all text-sm group"
        >
          <svg class="w-4 h-4 transition-transform group-hover:-translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
          </svg>
          <span>Isplutati na početnu</span>
        </a>

        <a
          href="/#cjenik"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3.5 bg-slate-100 hover:bg-slate-200 text-slate-800 font-bold rounded-xl border border-slate-200 shadow-sm transition-all text-sm"
        >
          <span>Pogledaj cjenik</span>
        </a>
      </div>

      <!-- Višejezična pomoćna napomena -->
      <div class="mt-10 pt-6 border-t border-slate-200 text-xs text-slate-600 flex items-center justify-center gap-4">
        <span>Page not found? <a href="/en/" class="text-sky-700 font-semibold hover:underline">English</a></span>
        <span>•</span>
        <span>Seite nicht gefunden? <a href="/de/" class="text-sky-700 font-semibold hover:underline">Deutsch</a></span>
      </div>
    </div>
  </main>

  <Footer lang="hr" />
</Layout>
