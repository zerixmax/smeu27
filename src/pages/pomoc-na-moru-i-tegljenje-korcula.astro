---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import QuickContactCTA from '../components/QuickContactCTA.astro';

const lang = 'hr';

const seoTitle = "Pomoć na moru 0–24 i tegljenje plovila | Korčula, Lastovo, Hvar, Vis";
const seoDescription = "Hitna pomoć plovilima u kvaru i tegljenje na području Vele Luke, otoka Korčule, Lastova, Hvara, Visa i poluotoka Pelješca. Brze intervencije namjenskim gliserima za vuču tereta, 0–24 h, uz koordinaciju sa servisom u Veloj Luci.";

const phoneDisplay = "+385 98 954 03 88";
const phoneRaw = "385989540388";

const interventionFeatures = [
  "Pomoć plovilima u kvaru na području srednjeg i južnog Jadrana",
  "Brze intervencije s polaskom iz Vele Luke (0–24 h)",
  "Koordinacija s servisom motora i podvodnim radovima",
  "Savjet i procjena situacije prije polaska"
];

const towingFeatures = [
  "Tegljenje plovila namjenskim gliserima za vuču tereta",
  "Tegljenje do luke, veza ili servisa u Veloj Luci",
  "Prilagodba brzine i načina tegljenja stanju mora",
  "Podrška kod kvara motora, propelera ili upravljanja"
];

const coverageAreas = [
  "Vela Luka i otok Korčula",
  "Lastovo i Lastovski kanal",
  "Hvar i Pakleni otoci",
  "Vis i Viški akvatorij",
  "Poluotok Pelješac",
  "Srednji i južni Jadran"
];

const emergencySituations = [
  "Motor se ne može pokrenuti ili se pregrijava",
  "Plovilo je izgubilo pogon, kormilo ili propelere",
  "Plovilo je nasukano ili se ne može osloboditi sidra",
  "Nestanak struje, problema s baterijama ili elektronikom",
  "Pogoršanje vremenskih uvjeta i potreba za sigurnim povratkom"
];

const processSteps = [
  {
    step: "01",
    title: "Poziv i lokacija",
    text: "Nazovite nas ili pošaljite WhatsApp poruku s pozicijom plovila, brojem osoba i opisom kvara."
  },
  {
    step: "02",
    title: "Procjena situacije",
    text: "Procjenjujemo udaljenost, stanje mora i najsigurniji način intervencije ili tegljenja."
  },
  {
    step: "03",
    title: "Dolazak gliserom",
    text: "Namjenski gliser kreće iz Vele Luke prema dogovorenoj poziciji, ovisno o vremenskim uvjetima."
  },
  {
    step: "04",
    title: "Tegljenje i zbrinjavanje",
    text: "Plovilo tegljimo do sigurne luke, veza ili servisa gdje se nastavlja dijagnostika i popravak."
  }
];

const whatsappMessage = encodeURIComponent("Pozdrav! Trebam pomoć na moru / tegljenje plovila. Pozicija: ");
const whatsappUrl = `https://wa.me/${phoneRaw}?text=${whatsappMessage}`;

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Pomoć na moru 0–24 i tegljenje plovila",
  "serviceType": "Marine assistance, boat towing, and emergency response",
  "provider": {
    "@type": "LocalBusiness",
    "@id": "https://suhamarina.eu/#business",
    "name": "Suha Marina Proizd",
    "telephone": "+385989540388"
  },
  "areaServed": ["Vela Luka", "Otok Korčula", "Lastovo", "Hvar", "Vis", "Pelješac", "Srednji i južni Jadran"],
  "description": seoDescription,
  "knowsAbout": [
    "Pomoć plovilima u kvaru",
    "Tegljenje plovila",
    "Hitne intervencije na moru",
    "Koordinacija sa servisom motora",
    "Tegljenje do luke ili servisa"
  ]
};
---

<Layout title={seoTitle} description={seoDescription} lang={lang}>
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />

  <Navbar lang={lang} />

  <main class="py-16 px-4 sm:px-6 lg:px-8 max-w-4xl mx-auto flex-1">

    <div class="mb-8">
      <a href="/" class="inline-flex items-center gap-2 text-xs font-mono font-semibold text-sky-700 hover:text-sky-900">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
        Povratak na naslovnu
      </a>
    </div>

    <header class="mb-12">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-orange-50 text-orange-800 border border-orange-200 text-xs font-semibold uppercase tracking-wider mb-4">
        <span class="w-2 h-2 rounded-full bg-orange-600"></span>
        0–24 intervencije • Tegljenje plovila • Srednji i južni Jadran
      </div>
      <h1 class="text-3xl sm:text-5xl font-black tracking-tight text-slate-900 leading-tight">
        POMOĆ NA MORU 0–24 I TEGLJENJE PLOVILA
      </h1>
      <p class="mt-4 text-base sm:text-lg text-slate-700 leading-relaxed">
        Pružamo hitnu pomoć plovilima u kvaru i tegljenje na području Vele Luke, otoka Korčule, Lastova, Hvara, Visa i poluotoka Pelješca. Brze intervencije iz Vele Luke namjenskim gliserima za vuču tereta.
      </p>
    </header>

    <section class="bg-white border border-slate-200 rounded-3xl p-6 sm:p-8 mb-12 shadow-sm">
      <h2 class="text-xl sm:text-2xl font-bold text-slate-900 mb-3">Hitna pomoć i tegljenje na moru</h2>
      <p class="text-sm sm:text-base text-slate-700 leading-relaxed mb-6">
        Ako plovilo izgubi pogon ili postoji potreba za sigurnim povratkom u luku, nazovite nas s pozicijom plovila i kratkim opisom situacije. Dogovorit ćemo najsigurniji način intervencije ili tegljenja.
      </p>

      <div class="flex flex-col sm:flex-row gap-4 pt-4 border-t border-slate-200">
        <a
          href={`tel:+${phoneRaw}`}
          class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl bg-red-600 hover:bg-red-700 text-white font-bold text-sm transition-colors shadow-sm"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
          Hitni poziv: {phoneDisplay}
        </a>
        <a
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl bg-[#25D366] hover:bg-[#20ba5a] text-white font-bold text-sm transition-colors shadow-sm"
        >
          <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86s.275.072.376-.043c.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.043.073.043.419-.101.824z"/></svg>
          Pošaljite poziciju putem WhatsAppa
        </a>
      </div>
    </section>

    <div class="rounded-2xl border border-amber-300 bg-amber-50 p-4 mb-12 text-xs sm:text-sm text-amber-900 leading-relaxed">
      <strong>Sigurnost je na prvom mjestu:</strong> ako je ugrožen život ili plovilo prijeti potonućem, odmah pozovite <strong>112</strong> i, ako je dostupno, javite se na <strong>VHF kanal 16</strong>. Nakon toga nas možete kontaktirati za tehničku pomoć i tegljenje.
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-12">

      <div class="bg-white border border-slate-200 rounded-3xl p-6 shadow-sm">
        <div class="w-10 h-10 rounded-xl bg-slate-100 text-orange-700 flex items-center justify-center font-bold mb-4 border border-slate-200">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
        </div>
        <h3 class="text-xl font-bold text-slate-900 mb-2">Hitne intervencije</h3>
        <p class="text-xs text-slate-600 mb-4 leading-relaxed">
          Brza pomoć plovilima u kvaru i koordinacija sa servisom:
        </p>
        <ul class="space-y-2 text-xs font-medium text-slate-700">
          {interventionFeatures.map((item) => (
            <li class="flex items-start gap-2">
              <svg class="w-3.5 h-3.5 text-orange-600 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg>
              {item}
            </li>
          ))}
        </ul>
      </div>

      <div class="bg-white border border-slate-200 rounded-3xl p-6 shadow-sm">
        <div class="w-10 h-10 rounded-xl bg-slate-100 text-orange-700 flex items-center justify-center font-bold mb-4 border border-slate-200">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 12h16M7 8l-3 4 3 4M17 8l3 4-3 4"/></svg>
        </div>
        <h3 class="text-xl font-bold text-slate-900 mb-2">Tegljenje plovila</h3>
        <p class="text-xs text-slate-600 mb-4 leading-relaxed">
          Sigurno tegljenje do luke, veza ili servisa:
        </p>
        <ul class="space-y-2 text-xs font-medium text-slate-700">
          {towingFeatures.map((item) => (
            <li class="flex items-start gap-2">
              <svg class="w-3.5 h-3.5 text-orange-600 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg>
              {item}
            </li>
          ))}
        </ul>
      </div>

    </div>

    <section class="bg-white border border-slate-200 rounded-3xl p-6 sm:p-8 mb-12 shadow-sm">
      <h2 class="text-xl font-bold text-slate-900 mb-4">Kada zvati pomoć na moru</h2>
      <ul class="space-y-2.5 text-sm text-slate-700">
        {emergencySituations.map((item) => (
          <li class="flex items-start gap-3">
            <span class="text-orange-600 font-bold">•</span>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </section>

    <section class="mb-12">
      <h2 class="text-xl sm:text-2xl font-bold text-slate-900 mb-2">Kako izgleda intervencija</h2>
      <p class="text-sm text-slate-600 mb-6">Od poziva do sigurnog zbrinjavanja plovila, u četiri koraka.</p>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {processSteps.map((item) => (
          <div class="p-5 rounded-2xl bg-white border border-slate-200 shadow-sm">
            <span class="text-xs font-mono font-bold text-orange-700">{item.step}</span>
            <h3 class="text-base font-bold text-slate-900 mt-1 mb-1">{item.title}</h3>
            <p class="text-xs text-slate-700 leading-relaxed">{item.text}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="bg-white border border-slate-200 rounded-3xl p-6 sm:p-8 mb-12 shadow-sm">
      <h2 class="text-xl font-bold text-slate-900 mb-4">Područje djelovanja</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-sm text-slate-700">
        {coverageAreas.map((area) => (
          <div class="flex items-center gap-2">
            <svg class="w-4 h-4 text-orange-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17.657 16.657L13.414 20.9a2 2 0 01-2.828 0l-4.243-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
            {area}
          </div>
        ))}
      </div>
      <p class="text-xs text-slate-600 mt-4 leading-relaxed">
        Za pozicije izvan navedenog područja javite se telefonom ili WhatsAppom kako bismo procijenili mogućnost intervencije.
      </p>
    </section>

    <section class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-12">
      <a href="/servis-i-dijagnostika-brodskih-motora" class="p-5 rounded-2xl bg-white border border-slate-200 hover:border-orange-500 transition-colors group shadow-sm">
        <span class="text-xs font-mono font-bold text-orange-700 uppercase tracking-wider">Povezana usluga</span>
        <h3 class="text-base font-bold text-slate-900 mt-1 group-hover:text-orange-700 transition-colors">Servis i dijagnostika brodskih motora →</h3>
        <p class="text-xs text-slate-600 mt-1">Nakon tegljenja, dijagnostika i popravak motora u servisu u Veloj Luci.</p>
      </a>
      <a href="/suhi-vez-i-kran-16t-korcula" class="p-5 rounded-2xl bg-white border border-slate-200 hover:border-orange-500 transition-colors group shadow-sm">
        <span class="text-xs font-mono font-bold text-orange-700 uppercase tracking-wider">Povezana usluga</span>
        <h3 class="text-base font-bold text-slate-900 mt-1 group-hover:text-orange-700 transition-colors">Suhi vez i kran 16 t →</h3>
        <p class="text-xs text-slate-600 mt-1">Vađenje kranom, pranje, smještaj na parceli 500 m od mora i popravci trupa.</p>
      </a>
      <a href="/podvodni-radovi-i-hrb-pregledi-korcula" class="p-5 rounded-2xl bg-white border border-slate-200 hover:border-orange-500 transition-colors group shadow-sm">
        <span class="text-xs font-mono font-bold text-orange-700 uppercase tracking-wider">Povezana usluga</span>
        <h3 class="text-base font-bold text-slate-900 mt-1 group-hover:text-orange-700 transition-colors">Podvodni radovi i HRB pregledi →</h3>
        <p class="text-xs text-slate-600 mt-1">Oslobađanje propelera, pregled trupa kamerom i sanacija podvodnog dijela.</p>
      </a>
      <a href="/ugradnja-minn-kota-garmin-force-korcula" class="p-5 rounded-2xl bg-white border border-slate-200 hover:border-orange-500 transition-colors group shadow-sm">
        <span class="text-xs font-mono font-bold text-orange-700 uppercase tracking-wider">Povezana usluga</span>
        <h3 class="text-base font-bold text-slate-900 mt-1 group-hover:text-orange-700 transition-colors">Brodska elektronika i solarni sustavi →</h3>
        <p class="text-xs text-slate-600 mt-1">Pramčani motori, sonari, radari, solarne ploče i pouzdano napajanje.</p>
      </a>
    </section>

  </main>

  <QuickContactCTA lang={lang} />
  <Footer lang={lang} />
</Layout>
